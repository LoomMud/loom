{
  "name": "@loommud/web-client",
  "version": "0.0.1",
  "private": true,
  "description": "Browser client for Loom's WebSocket adapter (OBI-39) and the staff web IDE (OBI-180): a text pane, an input line, GMCP hooks, and the Monaco-based file editor.",
  "license": "AGPL-3.0-only",
  "type": "module",
  "scripts": {
    "build": "node ../scripts/vendor-monaco.mjs && tsc -p tsconfig.json",
    "vendor": "node ../scripts/vendor-monaco.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "node --test dist/*.test.js dist/admin/*.test.js dist/ide/*.test.js",
    "lint": "node ../scripts/check-no-html-sinks.mjs && node ../scripts/check-static-csp.mjs && eslint .",
    "audit": "npm audit --include=dev --audit-level=high",
    "check-licenses": "license-checker-rseidelsohn --production --onlyAllow \"MIT;MIT-0;Apache-2.0;Apache*2.0;BSD-2-Clause;BSD-3-Clause;0BSD;ISC;Zlib;BSL-1.0;CC0-1.0;Unicode-3.0;Unicode-DFS-2016;MPL-2.0;LGPL-3.0-only;LGPL-3.0-or-later;GPL-3.0-only;GPL-3.0-or-later;AGPL-3.0-only;AGPL-3.0-or-later\" --excludePrivatePackages"
  },
  "devDependencies": {
    "@types/node": "22.10.5",
    "eslint": "9.29.0",
    "eslint-plugin-no-unsanitized": "4.1.2",
    "license-checker-rseidelsohn": "4.4.2",
    "typescript": "5.7.3",
    "typescript-eslint": "8.71.1"
  },
  "dependencies": {
    "monaco-editor": "0.57.0"
  }
}
