// D23: program variables holding object references must be `object?`.
var owner: object = self
var home = load_object("/room")
var ok_ref: object? = null
var ok_list: [object] = []

fn use_ref() {
    let o = ok_ref
    if o != null {
        o.poke()
    }
}
