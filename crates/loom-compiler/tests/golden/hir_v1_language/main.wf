// Clean: `import`/`const`, labelled + multiple inherit, and closure literals
// (OBI-24 V0 wiring: the remaining V1 acceptance-criteria gaps).
import /std/consts.{MAX, GREETING}
inherit combat = /std/a
inherit /std/b

pub fn total() -> int {
    return MAX + 1
}

pub fn greet() -> string {
    return GREETING
}

pub fn tags() -> string {
    return combat::combat_tag() + base_tag()
}

pub fn adder() -> fn(int) -> int {
    let f: fn(int) -> int = fn(x: int) -> int => x + 1
    return f
}

pub fn apply_adder() -> int {
    let f = adder()
    return f(41)
}
