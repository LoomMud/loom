//
// /std/player: the object bound to a connection. Phase 0 verb dispatcher:
// look, go <dir> and bare directions, say, update <path>, quit.

inherit /std/object

var connected: bool = false

var aliases: {string: string} = {
    "l": "look",
    "n": "north",
    "s": "south",
    "e": "east",
    "w": "west",
    "u": "up",
    "d": "down",
    "ne": "northeast",
    "nw": "northwest",
    "se": "southeast",
    "sw": "southwest"
}

pub override fn visible() -> bool {
    return connected
}

// Apply: the connection is now bound to this object.
fn logon() {
    connected = true
    write("Welcome to Oberfield (Loom Phase 0).")
    write($"You are {name}. Commands: look, go <dir> (or n/s/...), say <text>, update <path>, quit.")
    let start = load_object("/domains/start/hall")
    move_to(start)
    start.tell($"{name} arrives.", self())
    cmd_look()
}

// Apply: one line of input from the connection.
fn process_input(line: string) {
    let input = trim(line)
    if input == "" {
        return
    }
    let words = split(input, " ")
    var verb = words[0]
    let args = trim(rest(words))
    if verb in aliases {
        verb = aliases[verb]
    }

    if verb == "look" {
        cmd_look()
    } else if verb == "go" {
        cmd_go(args)
    } else if verb == "say" {
        cmd_say(args)
    } else if verb == "update" {
        cmd_update(args)
    } else if verb == "quit" {
        cmd_quit()
    } else if has_exit(verb) {
        cmd_go(verb)
    } else {
        write("What?")
    }
}

// Apply: the connection has gone away (quit or dropped).
fn net_dead() {
    if connected {
        connected = false
        environment()?.tell($"{name} leaves the game.", self())
    }
}

// Send one line of text to this player (send() is verbatim, so add the newline).
fn write(text: string) {
    send(self(), $"{text}\n")
}

// All words after the first, joined by single spaces.
fn rest(words: [string]) -> string {
    var out = ""
    var i = 1
    while i < len(words) {
        if out != "" {
            out += " "
        }
        out += words[i]
        i += 1
    }
    return out
}

fn has_exit(dir: string) -> bool {
    let env = environment()
    if env == null {
        return false
    }
    return env.exit_dest(dir) != null
}

fn cmd_look() {
    let env = environment()
    if env == null {
        write("You are nowhere.")
        return
    }
    write(env.long())
    for ob in inventory(env) {
        if ob != self() and ob.visible() {
            write($"{ob.short()} is here.")
        }
    }
}

fn cmd_go(dir_arg: string) {
    if dir_arg == "" {
        write("Go where?")
        return
    }
    var dir = dir_arg
    if dir in aliases {
        dir = aliases[dir]
    }
    let env = environment()
    if env == null {
        write("You are nowhere.")
        return
    }
    let path = env.exit_dest(dir)
    if path == null {
        write("You can't go that way.")
        return
    }
    let dest = load_object(path)
    env.tell($"{name} leaves {dir}.", self())
    move_to(dest)
    dest.tell($"{name} arrives.", self())
    cmd_look()
}

fn cmd_say(text: string) {
    if text == "" {
        write("Say what?")
        return
    }
    write($"You say: {text}")
    environment()?.tell($"{name} says: {text}", self())
}

// Phase 0: anyone may update anything (the tier model is Phase 1).
// With no argument, updates the current room.
fn cmd_update(path_arg: string) {
    var path = path_arg
    if path == "" {
        let env = environment()
        if env == null {
            write("Update what?")
            return
        }
        path = object_name(env)
    }
    let err = compile_object(path)
    if err == null {
        write($"{path}: Updated.")
    } else {
        write($"{path}: update failed.\n{err}")
    }
}

fn cmd_quit() {
    write("Goodbye.")
    disconnect(self())
}
