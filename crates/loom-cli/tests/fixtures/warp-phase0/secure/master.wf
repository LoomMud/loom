//
// /secure/master: the master object. Phase 0 only answers connect().
// No login yet: every connection gets a fresh guest player (guest1, guest2, ...).

var guests: int = 0

// Apply: called by the driver for each new connection. The driver binds the
// connection to the returned object and then calls logon() on it.
fn connect() -> object {
    guests += 1
    let player = clone_object("/std/player")
    player.set_name($"guest{guests}")
    return player
}

// Phase 0 policy (OBI-35): the driver fails closed without these applies.
// Everyone may use every efun and recompile anything; real tiers are S2.
fn valid_efun(name: string, class: int, ob: object) -> bool {
    return true
}

fn valid_compile(path: string, ob: object) -> bool {
    return true
}
