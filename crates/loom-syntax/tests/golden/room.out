(inherit /std/room)
(var persistent visits : int = 0)
(var private exits : {string: string} = {"north": "/domains/start/yard"})
(var pub tags : [string] = ["indoor" "quiet"])
(var owner : object? = null)
(fn override create ()
  (super::create)
  (call set_short "The great hall")
  (call set_long (interp "A long hall. Exits: " (call join (call keys exits) ", ") "."))
)
(fn pub describe (viewer: object?, brief: bool = false) -> string
  (+= visits 1)
  (if brief
    (return (call short))
   else
    (if (== viewer null)
      (return (call long))
     else
      (let name = (?? (?. viewer name) "someone"))
      (return (interp name " sees: " (call long) " (" visits " visits)"))
    )
  )
)
(fn busy (n: int) -> int
  (var total = 0)
  (var i = 0)
  (while (and (< i n) (not (> total 100)))
    (= total (- (+ total (* i 2)) (/ (% i 3) 1)))
    (+= i 1)
  )
  (for t in tags
    (if (or (in "indoor" [t]) (== t "x"))
      (-= total 1)
    )
  )
  (let m : {string: int} = {:})
  (= (index m "a") (neg total))
  (return (index m "a"))
)
