(inherit /std/item)
(inherit combat = /std/mixins/combat)
(import /include/damage {DamageKind Damage})
(const MAX_WEAR = 100)
(var private base_damage : int = 5)
(var protected kind : DamageKind = .slash)
(var persistent wear : int = 0)
(var last_swing : int = 0)
(fn override create ()
  (super::create)
  (call set_name "sword")
  (call set_short "a plain iron sword")
  (call add_ids ["sword" "blade"])
  (call add_verb "wield" do_wield)
)
(fn do_wield (args: string) -> bool
  (let me = (call this_player))
  (if (!= (call environment) me)
    (. me tell "You need to be holding it first.")
    (return false)
  )
  (. me wield self)
  (?. (call environment me) tell_room (interp (. me name) " wields " (call short) ".") exclude: [me])
  (return true)
)
(fn pub damage (target: object) -> int
  (var dmg = (- (+ base_damage (call random 4)) (/ wear 10)))
  (for ench in (call enchantments)
    (= dmg (?? (. ench modify_damage dmg target) dmg))
  )
  (return (call max dmg 0))
)
(fn atomic transfer_to (dest: object)
  (?. (call environment) remove_item self)
  (call move_to dest)
)
(fn upgrade (from_version: int, old: {string: any})
  (if (and (< from_version 3) (in "durability" old))
    (= wear (- MAX_WEAR (as (index old "durability") int)))
  )
)
