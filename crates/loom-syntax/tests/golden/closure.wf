var on_hit: fn(object, int) -> bool? = null
var hook: (fn(int) -> int)? = null

fn setup() {
    let inc = fn(x) => x + 1
    let typed = fn(x: int, y: int = 2) -> int => x * y
    let blk = fn(ob: object) {
        ob.tell("hi")
    }
    let nested = fn(a) => fn(b) => a + b
    add_verb("wield", do_wield)
    let doubled = map([1, 2, 3], fn(v) => v * 2)
    if any(items(), fn(it) => it.weight() > 10) {
        send(self, "heavy\n")
    }
    let r = handlers["look"](self, "")
    let s = nested(1)(2)
    fn() {
        send(self, "iife\n")
    }()
}
