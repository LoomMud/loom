struct Point {
    x: int
    y: int = 0
}

pub struct Damage { kind: DamageKind, amount: int = 1, tags: [string] = [] }

struct Empty {}

fn make() -> Point {
    var p = Point { x: 1, y: 2 }
    p.x += 3
    let d = Damage {
        kind: .slash,
        amount: p.x,
    }
    if p.x > 0 {
        p.y = d.amount
    }
    if (Point { x: 1 }).x == 1 {
        return Point { x: p.y }
    }
    return p
}
