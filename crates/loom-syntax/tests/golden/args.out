(fn tell_room (msg: string, exclude: [object] = [], ...rest: [any])
  (call send_all msg ...rest)
)
(fn log (...parts)
)
(fn f (me: object)
  (?. (call environment me) tell_room (interp (. me name) " waves.") exclude: [me])
  (call tell_room "x" exclude: [] color: true)
  (call format "{} {}" ...[1 2])
  (call log)
)
