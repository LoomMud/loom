(var on_hit : fn(object, int) -> bool? = null)
(var hook : (fn(int) -> int)? = null)
(fn setup ()
  (let inc = (closure (x) => (+ x 1)))
  (let typed = (closure (x: int, y: int = 2) -> int => (* x y)))
  (let blk = (closure (ob: object) {
    (. ob tell "hi")
  }))
  (let nested = (closure (a) => (closure (b) => (+ a b))))
  (call add_verb "wield" do_wield)
  (let doubled = (call map [1 2 3] (closure (v) => (* v 2))))
  (if (call any (call items) (closure (it) => (> (. it weight) 10)))
    (call send self "heavy\n")
  )
  (let r = (apply (index handlers "look") self ""))
  (let s = (apply (call nested 1) 2))
  (apply (closure () {
    (call send self "iife\n")
  }))
)
