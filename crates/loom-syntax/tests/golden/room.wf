// A room in the Phase 0 subset.
inherit /std/room

persistent var visits: int = 0
private var exits: {string: string} = {"north": "/domains/start/yard"}
pub var tags: [string] = ["indoor", "quiet"]
var owner: object? = null

override fn create() {
    super::create()
    set_short("The great hall")
    set_long($"A long hall. Exits: {join(keys(exits), ", ")}.")
}

pub fn describe(viewer: object?, brief: bool = false) -> string {
    visits += 1
    if brief {
        return short()
    } else if viewer == null {
        return long()
    }
    else {
        let name = viewer?.name() ?? "someone"
        return $"{name} sees: {long()} ({visits} visits)"
    }
}

fn busy(n: int) -> int {
    var total = 0; var i = 0
    while i < n and not (total > 100) {
        total = total + i * 2 - i % 3 / 1
        i += 1
    }
    for t in tags {
        if "indoor" in [t] or t == "x" { total -= 1 }
    }
    let m: {string: int} = {:}
    m["a"] = -total
    return m["a"]
}
