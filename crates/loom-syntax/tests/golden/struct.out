(struct Point
  (field x : int)
  (field y : int = 0)
)
(struct pub Damage
  (field kind : DamageKind)
  (field amount : int = 1)
  (field tags : [string] = [])
)
(struct Empty
)
(fn make () -> Point
  (var p = (struct Point x: 1 y: 2))
  (+= (field p x) 3)
  (let d = (struct Damage kind: .slash amount: (field p x)))
  (if (> (field p x) 0)
    (= (field p y) (field d amount))
  )
  (if (== (field (struct Point x: 1) x) 1)
    (return (struct Point x: (field p y)))
  )
  (return p)
)
