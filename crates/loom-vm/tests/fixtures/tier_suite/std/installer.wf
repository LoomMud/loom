//
// E1.3 tier suite: reviewed mudlib code meant to be inherited. install()
// writes wherever target() says; an inheritor may override target().

fn target() -> string {
    return "/doc/installed.txt"
}

pub fn install() -> bool {
    return write_file(target(), "installed")
}
