//
// E1.3 tier suite: a clonable heartbeat subscriber (uid `mudlib`; R1 bills
// a clone to whoever made it).

persistent var beats: int = 0

pub fn on() {
    set_heartbeat(true)
}

pub fn heartbeat() {
    beats += 1
}
