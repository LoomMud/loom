// Minimal player: a handful of verbs, enough to walk and update.
var name: string = "guest"
persistent var moves: int = 0
persistent var beats: int = 0
persistent var last_call_out: int = -1
persistent var burn_count: int = 0

pub fn logon() {
    send(self, "Welcome to Loom!\n")
    move_to(load_object("/domains/start/hall"))
    send(self, environment()?.look())
}

pub fn heartbeat() {
    beats += 1
}

pub fn pong() {
    send(self, $"pong {last_call_out}\n")
}

pub fn process_input(line: string) {
    let words = split(trim(line), " ")
    let verb = words[0]
    if verb == "look" {
        send(self, environment()?.look())
    } else if verb == "go" and len(words) == 2 {
        let dest = environment()?.exit_dest(words[1])
        if dest == null {
            send(self, "You can't go that way.\n")
            return
        }
        move_to(load_object(dest))
        moves += 1
        send(self, environment()?.look())
    } else if verb == "update" and len(words) == 2 {
        let err = compile_object(words[1])
        if err == null {
            send(self, $"Updated {words[1]}.\n")
        } else {
            send(self, $"{err}\n")
        }
    } else if verb == "name" and len(words) == 2 {
        name = words[1]
        send(self, $"You are now {name}.\n")
    } else if verb == "loop" {
        var i = 0
        while true {
            i += 1
        }
    } else if verb == "burncompile" {
        while true {
            compile_object("/std/player")
            burn_count += 1
        }
    } else if verb == "burncompile_try" {
        // OBI-32 CTO follow-up: tick exhaustion caused by efun cost
        // (`compile_object` at 500 ticks, not a per-backedge `TickCheck`)
        // must still be uncatchable — the `catch` body below must never
        // run, no matter how small the tick budget.
        try {
            while true {
                compile_object("/std/player")
                burn_count += 1
            }
        } catch e {
            send(self, "CAUGHT (should never happen)\n")
        }
    } else if verb == "burnlen" {
        while true {
            len(words)
            burn_count += 1
        }
    } else if verb == "burncount" {
        send(self, $"{burn_count}\n")
    } else if verb == "recurse" {
        dive(0)
    } else if verb == "sched" {
        last_call_out = call_out("pong", 2)
        send(self, $"scheduled {last_call_out}\n")
    } else if verb == "cancel" {
        let ok = remove_call_out(last_call_out)
        send(self, $"cancelled {ok}\n")
    } else if verb == "hbon" {
        set_heartbeat(true)
        send(self, "heartbeat on\n")
    } else if verb == "hboff" {
        set_heartbeat(false)
        send(self, "heartbeat off\n")
    } else if verb == "beats" {
        send(self, $"{beats}\n")
    } else if verb == "rand" and len(words) == 2 {
        let n = to_int(words[1]) ?? 0
        send(self, $"{random(n)}\n")
    } else if verb == "toint" and len(words) == 2 {
        send(self, $"{to_int(words[1])}\n")
    } else if verb == "lower" and len(words) == 2 {
        send(self, $"{lower(words[1])}\n")
    } else if verb == "now" {
        send(self, $"{time() > 0}\n")
    } else if verb == "usercount" {
        send(self, $"{len(users())}\n")
    } else if verb == "readfile" and len(words) == 2 {
        send(self, $"{read_file(words[1])}\n")
    } else if verb == "writefile" and len(words) == 3 {
        send(self, $"{write_file(words[1], words[2])}\n")
    } else if verb == "selfdestruct" {
        destruct(self)
        send(self, "destructing self did not crash the frame\n")
    } else if verb == "selfdestructfield" {
        destruct(self)
        moves += 1
    } else if verb == "makeaccount" and len(words) == 3 {
        send(self, $"req {account_create(words[1], words[2])}\n")
    } else if verb == "loginaccount" and len(words) == 3 {
        send(self, $"req {account_login(words[1], words[2])}\n")
    } else {
        send(self, "What?\n")
    }
}

pub fn account_result(id: int, ok: bool, detail: string) {
    send(self, $"account_result {id} {ok} {detail}\n")
}

// Test-only helpers (OBI-85 CTO review): construct arbitrary
// container/item relationships and destruct them directly, without going
// through a connection, so `tests/obi_85_efuns.rs` can check where an
// item's inventory ends up.
pub fn spawn_clone() -> object {
    return clone_object("/std/player")
}

pub fn move_into(dest: object) {
    move_to(dest)
}

pub fn destruct_self() {
    destruct(self)
}

pub fn destructed_of(ob: object?) -> bool {
    return destructed(ob)
}

pub fn environment_of(ob: object?) -> object? {
    return environment(ob)
}

pub fn destruct_of(ob: object) {
    destruct(ob)
}

pub fn equals(a: object?, b: object?) -> bool {
    return a == b
}

fn dive(n: int) -> int {
    return dive(n + 1)
}

pub fn net_dead() {
}
