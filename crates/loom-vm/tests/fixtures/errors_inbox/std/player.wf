// A minimal player for the OBI-169 error-inbox fixture: a `boom` verb to
// raise a runtime error (for grouping), `spawnvault` to clone a
// `/std/vault` whose heartbeat raises its own error every tick (for the
// `errors()` efun's per-program permission filter -- `secure/master.wf`'s
// `valid_read` denies `/std/vault`), and `errorcount` to call the
// `errors()` efun itself and report back how many rows it saw.
pub fn logon() {
    send(self, "ready\n")
}

pub fn process_input(line: string) {
    let words = split(trim(line), " ")
    let verb = words[0]
    if verb == "boom" {
        random(0)
    } else if verb == "spawnvault" {
        clone_object("/std/vault")
        send(self, "spawned\n")
    } else if verb == "errorcount" {
        var filter = ""
        if len(words) == 2 {
            filter = words[1]
        }
        let rows = errors(filter)
        send(self, $"{len(rows)}\n")
    } else {
        send(self, "What?\n")
    }
}

pub fn net_dead() {
}
