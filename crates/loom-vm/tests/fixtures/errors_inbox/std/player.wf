// A minimal player for the OBI-169 error-inbox fixture: a `boom` verb to
// raise a runtime error (for grouping), `spawnvault` to clone a
// `/std/vault` whose heartbeat raises its own error every tick (for the
// `errors()` efun's per-program permission filter -- `secure/master.wf`'s
// `valid_read` denies `/std/vault`), and `errorcount` to call the
// `errors()` efun itself and report back how many rows it saw.
pub fn logon() {
    send(self, "ready\n")
}

pub fn process_input(line: string) {
    let words = split(trim(line), " ")
    let verb = words[0]
    if verb == "boom" {
        random(0)
    } else if verb == "spawnvault" {
        clone_object("/std/vault")
        send(self, "spawned\n")
    } else if verb == "triggerleak" {
        load_object("/secure/leak").boom()
    } else if verb == "triggervault2" {
        load_object("/secure/vault2").boom()
    } else if verb == "become" and len(words) == 2 {
        seteuid(words[1])
        send(self, "ok\n")
    } else if verb == "errorcount" {
        var filter = ""
        if len(words) == 2 {
            filter = words[1]
        }
        let rows = errors(filter)
        send(self, $"{len(rows)}\n")
    } else if verb == "errormessage" and len(words) == 2 {
        let rows = errors(words[1])
        if len(rows) == 0 {
            send(self, "none\n")
        } else {
            let m = rows[0]["message"] ?? "?"
            send(self, $"{m}\n")
        }
    } else if verb == "viaerrormessage" and len(words) == 3 {
        // OBI-287 (M-ERR-1): same query as `errormessage`, but routed
        // through `words[1]`'s `run` -- a command object stand-in
        // (`self_object()` is that object while the efun runs, not the
        // player) -- so the redaction tier has to come from the guard
        // set, not `self_object()`'s own euid.
        let m = load_object(words[1]).run(words[2])
        send(self, $"{m}\n")
    } else {
        send(self, "What?\n")
    }
}

pub fn net_dead() {
}
