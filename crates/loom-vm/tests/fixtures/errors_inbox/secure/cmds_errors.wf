// M-ERR-1 (OBI-287) fixture: stands in for a command object such as
// `/cmds/builder/errors` -- a driver-shipped command, not a builder's
// own workroom code, so it lives under `/secure/**` and (per
// `Registry::uid_for`) is root-owned regardless of what the master's
// `creator_file` apply says (that apply's answer is filtered to reject
// `root` outright -- a builder-supplied path can never claim root
// ownership that way). It calls the `errors()` efun itself with
// `self_object()` as *this* object, not the player who invoked it --
// exactly the case `errors_efun`'s M-ERR-1 redaction floor must get
// right by reading the caller's guard set instead of this object's own
// (root, and therefore skipped by `GuardSet` entirely) euid.
pub fn run(filter: string) -> string {
    let rows = errors(filter)
    if len(rows) == 0 {
        return "none"
    }
    return rows[0]["message"] ?? "?"
}
