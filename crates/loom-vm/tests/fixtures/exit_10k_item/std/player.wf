// Minimal player: just enough verbs to drive the OBI-91 exit test
// (10k /std/item clones, recompile + upgrade_all, zero disconnects,
// p99 tick latency). One connection acts as the "operator" (clones
// items, drives the recompile/upgrade_all); the rest are "live client"
// connections that just keep their heartbeat running so the test can
// prove they were never disconnected during the mass migration.
persistent var beats: int = 0

pub fn heartbeat() {
    beats += 1
}

pub fn process_input(line: string) {
    let words = split(trim(line), " ")
    let verb = words[0]
    if verb == "clone_item" {
        let t = clone_object("/std/item")
        send(self, $"cloned {object_name(t)}\n")
    } else if verb == "upgrade_item" {
        let n = upgrade_all("/std/item")
        send(self, $"queued {n}\n")
    } else if verb == "hbon" {
        set_heartbeat(true)
        send(self, "heartbeat on\n")
    } else if verb == "hboff" {
        set_heartbeat(false)
        send(self, "heartbeat off\n")
    } else if verb == "beats" {
        send(self, $"{beats}\n")
    } else {
        send(self, "What?\n")
    }
}

pub fn net_dead() {
}
