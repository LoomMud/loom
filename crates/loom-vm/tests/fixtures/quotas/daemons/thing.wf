// A `/daemons`-style shared program: no `/builders`/`/domains` prefix, so
// its own uid is the `default_creator` fallback, `mudlib` -- an
// always-unlimited uid (OBI-121 S2c `crate::quota::is_unlimited_uid`).
// R1 confines a clone of this to whichever uid's guard set didn't already
// contain `mudlib` (`workroom.wf`'s `spawn_daemon`).
pub fn ids() -> string {
    return $"{getuid()}/{geteuid()}"
}

// CTO review N3: a heartbeat subscribed on an R1 clone of this program
// must be billed to the clone's `owner` (the apprentice that spawned it),
// not to this program's own `uid` (`mudlib`, always-unlimited -- if it
// were billed there, `max_heartbeats` could never actually apply).
pub fn subscribe() {
    set_heartbeat(true)
}

pub fn heartbeat() {
}
