// Mudlib-owned player (OBI-121 S2c, CTO review B3 fixture fix): a real
// mudlib has exactly one player program, cloned per connection, whose
// *owner/uid* is always `mudlib` -- what tells one player from another is
// its *euid*, set post-clone by `/secure/login`'s `seteuid`, not a
// separate owner per account. This fixture exercises that shape directly:
// confinement rules 2/3 must key on euid tier, not on owner/uid (`mudlib`
// is never staff, so keying on owner/uid would make every player, staff
// included, tier 0).
pub fn logon() {
    send(self, "ready\n")
}

// Called once, right after `connect()` clones this, to assign the
// account's euid (mirrors `/secure/login`'s post-auth `seteuid`).
pub fn set_account(e: string) {
    seteuid(e)
}

pub fn move_into_obj(dest: object) {
    move_to(dest)
}

// OBI-153: lets a test push this player (a tier-0 principal, since
// `guest` has no `staff` row at all) onto the guard *below* a `/cmds/**`
// command frame -- exactly the shape of a real player typing a command
// -- so the command's own target code sees a guard containing both the
// tier-0 player and whichever staff principal is actually acting.
pub fn do_cmd(cmd: object, target: object) -> object {
    return cmd.run(target)
}

pub fn net_dead() {
}
