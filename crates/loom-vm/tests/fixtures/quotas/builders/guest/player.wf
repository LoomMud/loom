// A genuinely tier-0-owned interactive (owner `guest`, no `staff` row in
// this fixture's roles seed) for the confinement tests (spec §7 rule 2:
// "a `Confined` object cannot move into a tier-0 player's inventory";
// rule 3: "a tier-0 player cannot enter a `Confined` room").
pub fn logon() {
    send(self, "ready\n")
}

pub fn move_into_obj(dest: object) {
    move_to(dest)
}

