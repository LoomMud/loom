// Owner `appr` (from the `/builders/appr/**` convention): the driver-
// level fixture for the object-count/memory/disk/R1 quota tests, called
// directly by `World::call` (root-acting), which is fine since every one
// of these quotas is keyed on *this object's own owner* (`max_objects`,
// `max_mem_exec_mb`) or on whatever `/daemons/thing` R1 confines its
// clone's owner to -- none of them depend on who is calling.
var data: [int] = []
persistent var blob: string = ""

pub fn set_blob(s: string) {
    blob = s
}

pub fn grow(n: int) {
    // Double the array by self-concatenation (O(log n) concats, each
    // O(current size)) instead of appending one element at a time, so
    // this stays O(n log n) rather than O(n^2) -- the point of this fn
    // is to trip the memory/tick quota quickly, not to hit an exact
    // size, so an overshoot from doubling past n is fine.
    var a: [int] = [0]
    while len(a) < n {
        a = a + a
    }
    data = a
}

// R1 (OBI-121 S2c spec §7): `/daemons/thing`'s own uid (`mudlib`, the
// `default_creator` fallback -- no `/builders`/`/domains` prefix) is not
// in this call's guard set (just `appr`, this object's own principal), so
// the clone's owner/euid is confined to `appr` instead.
pub fn spawn_daemon() -> object {
    return clone_object("/daemons/thing")
}

pub fn write_disk(p: string, text: string) -> bool {
    return write_file(p, text)
}

// OBI-171 (CTO review on PR #75, must-fix 2): `save_object`'s own
// `disk_quota_mb` charge, keyed on *this object's own uid* (`appr`) --
// unlike `write_disk` above, the save path carries no uid in its text at
// all, so there is nothing here for the quota check to parse out of `p`.
pub fn save_disk(p: string) -> bool {
    return save_object(p)
}

// CTO review N4 fixture: calls through a mudlib-owned `/std` helper
// (`spawn_via_helper`) so the test can prove `caller_quota_uid` ranks
// `appr` (T1) over `mudlib` (an always-unlimited uid, tier 0 in the
// snapshot but never billable) when picking whose quota the helper's own
// `clone_object`/`call_out` are charged to.
pub fn spawn_via_helper(path: string) -> object {
    return load_object("/std/helper").clone_and_schedule(path)
}
