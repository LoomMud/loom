//
// /domains/start/yard: a clean leaf room, used for hover/definition/
// completion tests (no diagnostics expected here).

inherit /std/room

pub override fn short() -> string {
    return "the training yard"
}

pub fn greet() -> string {
    let who = short()
    return $"Welcome to {who}."
}
