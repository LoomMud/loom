#
# Names only (M-X-5, docs/threat-model-phase2.md §6.1/§9). This file is
# never filled in and never committed with real values -- it documents
# which secrets exist and where they come from, so a new deploy or a
# `cargo deny`/gitleaks run has something to diff against. Real values are
# provisioned per environment: staging gets them from
# `/etc/loom/secrets.env` (OBI-42) or SOPS-encrypted values decrypted by
# Flux (loom-gitops), never committed in cleartext anywhere.
#
# Deploy gate (OBI-195 follow-up tracking, PR #73 review): `LOOM_JWT_SECRET`
# (the retired HS256 shared-secret var) must not be set in any environment.
# As of OBI-197 the driver no longer reads it at all, so setting it has no
# effect -- it is listed here only as a "do not resurrect this" marker.

# --- Staff auth (OBI-174, OBI-197/M-AUTH-4) ---

# Path to the mounted EdDSA (Ed25519) signing keyset for staff access
# JWTs -- see `loom_http::auth::JwtKeys::from_key_file` for its JSON
# shape (one active signing key by `kid`, plus any keys still inside
# their post-rotation overlap window). Mode 0400, owned by the `loom`
# user. `/auth/*` is unmounted entirely without this set.
LOOM_JWT_KEY_FILE=

# This service's `iss` claim for staff access tokens (M-AUTH-4). Not a
# secret, but kept alongside the key file so the two are rotated/deployed
# together; has a safe compiled-in default if unset.
LOOM_JWT_ISSUER=

# TOTP secrets-at-rest encryption key (M-AUTH-8: "encrypted ... under a
# key from the secret file, not in plaintext in Postgres"). Not yet wired
# up -- `staff.totp_secret` is still plaintext as of OBI-174/OBI-197; see
# the OBI-174 PR description and the threat-model's residual-risk section.
LOOM_TOTP_ENCRYPTION_KEY=

# --- GitHub login (OBI-174, M-AUTH-7) ---

LOOM_GITHUB_OAUTH_CLIENT_ID=
LOOM_GITHUB_OAUTH_CLIENT_SECRET=

# --- `propose`, the GitHub App, and the merge webhook (OBI-181, M-GH-7) ---
# `loom-propose` is its own App (D-TM6), installed on `warp` only --
# never the OBI-43 reviewer App's key.

LOOM_PROPOSE_GITHUB_APP_ID=
LOOM_PROPOSE_GITHUB_APP_PRIVATE_KEY=
LOOM_PROPOSE_WEBHOOK_SECRET=

# --- Database (not staff-auth-specific, listed for completeness) ---

LOOM_DATABASE_URL=
