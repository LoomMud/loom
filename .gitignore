/target
*.swp
.env
.env.*
/web-client/node_modules
/web-client/dist
# CI-only diagnostics from the load jobs (OBI-344): the serve log, the final
# /metrics scrape and the runner context are uploaded as artifacts and must
# never be committed -- they carry per-run timing numbers and nothing else.
/results/loom-serve*.log
/results/loom-metrics-final.txt
/results/runner-context*.txt
# The vendored Monaco build (M-IDE-3, OBI-180). A *build artifact*, not
# source: `npm run vendor` copies it out of `node_modules/monaco-editor`
# -- whose exact version the lockfile pins and `npm audit` scans -- so the
# served tree has no CDN reference and the repo doesn't carry 25 MB of
# third-party JS. `npm run build` regenerates it; CI builds before lint,
# and `scripts/check-static-csp.mjs` fails if any served file points
# off-origin anyway.
/web-client/vendor
# CI-only loadtest-smoke/loadtest-e1-1 output (OBI-40/OBI-177); real runs'
# results/*.json,*.md are committed by hand.
/results/ci-smoke.*
/results/ci-e1-1.*

# Python bytecode from scripts/ that import each other (rule 9 reads the
# classifier as a module). Never a source file, never worth a dirty tree.
__pycache__/
