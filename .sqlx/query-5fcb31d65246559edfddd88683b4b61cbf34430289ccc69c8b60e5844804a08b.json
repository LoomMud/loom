  "query": "\n            SELECT id, at, kind, caller, effective_principal, apply, class,\n                   guard_set, verdict, detail, argument\n            FROM audit_log\n            WHERE $1::BIGINT IS NULL OR id < $1\n            ORDER BY id DESC\n            LIMIT $2\n            ",
